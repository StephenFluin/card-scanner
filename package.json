{
  "name": "card-scanner",
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:ssr:card-scanner": "node dist/card-scanner/server/server.mjs",
    "catalog": "tsx scripts/build-catalog.ts",
    "scans": "tsx scripts/download-scans.ts",
    "eval": "tsx scripts/eval.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "start:phone": "ng serve --ssl --host 0.0.0.0 --allowed-hosts",
    "learn-catalog": "tsx scripts/learn-catalog.ts",
    "test:rules": "firebase emulators:exec --only database,storage --project card-scanner-rules-test \"tsx scripts/test-rules.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.2",
    "express": "^5.1.0",
    "firebase": "^13.0.0",
    "rxjs": "~7.8.0",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0"
  }
}
